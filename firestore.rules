rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kiraishikagi@vera.plus"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validation Helpers
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['uid', 'message', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.createdAt == request.time;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['uid', 'scenarioId', 'score', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.scenarioId is string && data.scenarioId.size() <= 64 &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             data.createdAt == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        !incoming().keys().contains('role') || 
        incoming().role == 'user' || 
        isAdmin()
      );
      
      allow update: if isSignedIn() && (
        (isOwner(uid) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'hasSeenWelcome', 'streak', 'lastVisit', 'achievements', 'purchasedArticles']) &&
         incoming().uid == existing().uid &&
         incoming().email == existing().email &&
         incoming().role == existing().role &&
         incoming().createdAt == existing().createdAt
        ) || isAdmin()
      );
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidFeedback(incoming());
    }

    match /sessions/{sessionId} {
      allow get: if isOwner(existing().uid) || isAdmin();
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidSession(incoming());
      
      allow update: if isSignedIn() && (
        (isOwner(existing().uid) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['detailedAnalysis', 'isUnlocked', 'messages', 'score']) &&
         isValidSession(incoming()) &&
         incoming().uid == existing().uid &&
         incoming().createdAt == existing().createdAt
        ) || isAdmin()
      );
      
      allow delete: if isAdmin();
    }
  }
}
